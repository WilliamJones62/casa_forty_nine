<%= render 'layouts/datepicker_files' %>

<div class="d-flex p-2 m-5">
  <div class="container shadow py-2">
    <h4 class="mb-3">Reserve <%= @property.name %></h4>
    <div class="row justify-content-center">
    <% if defined? @edit %>
    <form action="/reservations/change">
      <input type="hidden" id="id" name="id" value="<%= @reservation.id %>">
    <% else %>
    <form action="/properties/reservation">
    <% end %>
        <div class="col">
          <p class="fw-bold"> CHECK-IN </p>
          <input type="text" class="form-control test-datepickers" name="checkin" id="dp1" value="<%= @checkin %>" readonly>
        </div>
        <div class="col">
          <p class="fw-bold"> CHECKOUT </p>
          <input type="text" class="form-control test-datepickers" name="checkout" id="dp2" value="<%= @checkout %>" readonly>
        </div>
        <input type="hidden" id="formprice" name="formprice" value="<%= @price %>">
        <input type="hidden" id="formfullprice" name="formfullprice" value="<%= @fullprice %>">
        <input type="hidden" id="formmonthlydiscount" name="formmonthlydiscount" value="<%= @monthlydiscount %>">
        <input type="hidden" id="formnights" name="formnights" value="<%= @nights %>">
        <% if user_signed_in? %>
        <div class="justify-content-center d-grid">
          <br>
          <input type="submit" value="Reserve" class="w-100 btn btn-secondary btn-lg" id="reservationSubmit">
        </div>
        <% end %>

    </form> 
    </div>
    <br>
    <div id="priceDisplay">
      <p class="fs-6">
        <% if @fullprice != @price %>
        <span id="discountPrice">
          <del>$<span id="fullprice" value="<%= @fullprice %>" class="fw-light"><%= number_with_delimiter(@fullprice) %></span></del>
        </span>
        <% end %>
        <a href="#" class="link-opacity-100" data-bs-toggle="modal" data-bs-target="#priceModal">
          $<span id="price" value="<%= @price %>"><%= number_with_delimiter(@price) %></span>
        </a>
        for <span id="nights" value="<%= @nights %>"></span> nights
      </p>
      <p class="fs-6">Price includes all fees</p>
      <% if !user_signed_in? %>
      <a class="nav-link fs-6" href="#" data-bs-toggle="modal" data-bs-target="#signInModal">Sign in to reserve this property</a>
      <% end %>
    </div>
  </div>
</div>

<%= render 'layouts/datepicker_script' %>
<%= render 'layouts/price_modal' %>
