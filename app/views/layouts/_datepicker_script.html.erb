<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function() {
  const dp1 = document.querySelector("#dp1");
  const dp2 = document.querySelector("#dp2");
  const minimumDate = new Date("<%= @minimum_date %>");
  const maximumDate = new Date("<%= @maximum_date %>");
  <% if @checkin != '' %>
    const selectedIn = new Date("<%= @selectedin %>".replace(/-/g, '\/').replace(/T.+/, ''));
  <% end %>
  <% if @checkout != '' %>
    const selectedOut = new Date("<%= @selectedout %>".replace(/-/g, '\/').replace(/T.+/, ''));
  <% end %>
  var reserved_dates = [];
  const x = document.getElementById("priceDisplay");
  x.style.display = "none";
  <% if user_signed_in? %>
    const y = document.getElementById("reservationSubmit");
    y.style.display = "none";
  <% end %>

  <% @reserved_dates.each do |date| %>
    reserved_dates.push(new Date("<%= date %>"));
  <% end %>

  checkIn = datepicker(dp1, {
    id: 1,
    minDate: minimumDate,
    maxDate: maximumDate,
    disabledDates: reserved_dates,
    <% if @checkin != '' %>
      dateSelected: selectedIn,
    <% end %>
    onSelect: (instance, date) => {
      // instance: The datepicker instance
      // date: The selected Date object
      setNewEndDate(checkOut, date, reserved_dates);
    },
    formatter: (input, date, instance) => {
      const offset = date.getTimezoneOffset();
      date = new Date(date.getTime() - (offset * 60 * 1000));
      input.value = date.toISOString().split('T')[0];
    },
    showAllDates: true
  });
  checkOut = datepicker(dp2, {
    id: 1,
    minDate: minimumDate,
    maxDate: maximumDate,
    disabledDates: reserved_dates,
    <% if @checkout != '' %>
      dateSelected: selectedOut,
    <% end %>
    onSelect: (instance, date) => {
      setNewStartDate(checkIn, date, reserved_dates);
    },
    formatter: (input, date, instance) => {
      const offset = date.getTimezoneOffset();
      date = new Date(date.getTime() - (offset * 60 * 1000));
      input.value = date.toISOString().split('T')[0];
    },
    showAllDates: true
  });
  if (window.location.pathname == "/properties/reservation") {
    document.getElementById("nights").innerHTML = <%= @nights %>;
    document.getElementById("price").innerHTML = <%= @price %>;
    document.getElementById("formprice").value = <%= @price %>;
    document.getElementById("formprice_strip").value = <%= @price %>;
    x.style.display = "block";
  }
});

function setNewEndDate(instance, date, reserved_dates) {
  date.setDate(date.getDate() + 1);
  try {
    instance.setMin(date);
  }
  catch(err) {

  }
  calculatePrice(instance, reserved_dates);
}

function setNewStartDate(instance, date, reserved_dates) {
  date.setDate(date.getDate() - 1);
  try {
    instance.setMax(date);
  }
  catch(err) {
    
  }
  calculatePrice(instance, reserved_dates);
}

function calculatePrice(instance, reserved_dates) {
  const x = document.getElementById("priceDisplay");
  <% if user_signed_in? %>
  const y = document.getElementById("reservationSubmit");
  <% end %>
  var dateRange = instance.getRange();
  if (typeof dateRange["start"] === "undefined" || typeof dateRange["end"] === "undefined") {
  // range not complete
    x.style.display = "none";
    <% if user_signed_in? %>
    y.style.display = "none";
    <% end %>
    return;
  }
  if (reserved_dates.length != 0 && reserved_dates[0] < dateRange["end"] && reserved_dates[reserved_dates.length -1] > dateRange["start"]) {
  // there are potential clashes with other reservations
    for (let i = 0; i < reserved_dates.length; i++) {
      if (reserved_dates[i] > dateRange["start"] && reserved_dates[i] < dateRange["end"]) {
        alert("Reservation must not include unavailable dates!");
        return;
      }
    }
  }
  // load the price and number of nights into the DOM
  var highStartMonth = <%= @property.high_start_date.month %> - 1;
  const highStartDay = <%= @property.high_start_date.mday %>;
  var highEndMonth = <%= @property.high_end_date.month %> - 1;
  const highEndDay = <%= @property.high_end_date.mday %>;
  var highStartYear = <%= @property.high_start_date.year %>;
  var highEndYear = <%= @property.high_start_date.year %>;
  const rangeStartYear = dateRange["start"].getFullYear();
  var rangeStartMonth = dateRange["start"].getMonth();
  const rangeStartDay = dateRange["start"].getDate();
  const rangeEndYear = dateRange["end"].getFullYear();
  var rangeEndMonth = dateRange["end"].getMonth();
  const rangeEndDay = dateRange["end"].getDate();
  var highEndAdjust = 0;
  if (highStartMonth > highEndMonth) {
    highEndAdjust = 1;
  }
  if (rangeStartMonth < highStartMonth || 
     (rangeStartMonth == highStartMonth && rangeStartDay < highStartDay) ||
     rangeStartMonth > highEndMonth ||
     (rangeStartMonth == highEndMonth && rangeStartDay > highEndDay)) {
    highStartYear = rangeStartYear;
  } else {
    highStartYear = rangeStartYear - 1;
  }
  highEndYear = highStartYear + highEndAdjust;
  var highStartDate = new Date();
  var highEndDate = new Date();
  var lowEndDate = new Date();
  var lowStartDate = new Date();
  highStartDate.setFullYear(highStartYear, highStartMonth, highStartDay);
  highStartDate.setHours(0, 0, 0, 0);
  highEndDate.setFullYear(highEndYear, highEndMonth, highEndDay);
  highEndDate.setHours(0, 0, 0, 0);

  var lowNights = 0;
  var highNights = 0;

  if (dateRange["end"] < highStartDate || dateRange["start"] > highEndDate) {
    lowNights = getNumberOfDaysBetweenDates(dateRange["start"], dateRange["end"]);
    highNights = 0;
  } else if (dateRange["end"] <= highEndDate && dateRange["start"] >= highStartDate) {
    highNights = getNumberOfDaysBetweenDates(dateRange["start"], dateRange["end"]);
    lowNights = 0;
  } else if (dateRange["end"] >= highStartDate && dateRange["end"] <= highEndDate) {
    highNights = getNumberOfDaysBetweenDates(highStartDate, dateRange["end"]);
    lowEndDate = new Date(highStartDate - 86400000);
    lowEndDate.setHours(0, 0, 0, 0);
    lowNights = getNumberOfDaysBetweenDates(dateRange["start"], lowEndDate);
  } else if (dateRange["start"] >= highStartDate && dateRange["start"] <= highEndDate) {
    highNights = getNumberOfDaysBetweenDates(dateRange["start"], highEndDate);
    lowStartDate = new Date(highEndDate + 86400000);
    lowStartDate.setHours(0, 0, 0, 0);
    lowNights = getNumberOfDaysBetweenDates(lowStartDate, dateRange["end"]);
  } else {
    highNights = getNumberOfDaysBetweenDates(highStartDate, highEndDate);
    lowEndDate = new Date(highStartDate - 86400000);
    lowEndDate.setHours(0, 0, 0, 0);
    lowNights = getNumberOfDaysBetweenDates(dateRange["start"], lowEndDate);
    lowStartDate = new Date(highEndDate + 86400000);
    lowStartDate.setHours(0, 0, 0, 0);
    lowNights += getNumberOfDaysBetweenDates(lowStartDate, dateRange["end"]);
  }
  
  var nights = lowNights + highNights;
  if (nights < 29) {
    document.getElementById("discount").style.display = "none";
    document.getElementById("discountPrice").style.display = "none";
  } else {
    document.getElementById("discount").style.display = "block";
    document.getElementById("discountPrice").style.display = "inline";
  }
  var price = (lowNights * <%= @property.price_cents / 100 %>) + (highNights * <%= @property.high_price_cents / 100 %>);
  const monthlyDiscount = getMonthlyDiscount(nights, price);
  document.getElementById("modalrate").innerHTML = (price / nights).toFixed(2);
  document.getElementById("nights").innerHTML = nights;
  document.getElementById("modalnights").innerHTML = nights;
  document.getElementById("modalstandardprice").innerHTML = price.toLocaleString();
  document.getElementById("fullprice").innerHTML = price.toLocaleString();
  document.getElementById("formfullprice").value = price;
  price = price - monthlyDiscount;
  document.getElementById("price").innerHTML = price.toLocaleString();
  document.getElementById("modalprice").innerHTML = price.toLocaleString();
  document.getElementById("formprice").value = price;
  document.getElementById("formnights").value = nights;
  x.style.display = "block";
  <% if user_signed_in? %>
  if (window.location.pathname != '/properties/reservation') {
    y.style.display = "block";
  } else {
    document.getElementById("checkin_strip").value = document.getElementById("dp1").value;
    document.getElementById("checkout_strip").value = document.getElementById("dp2").value;
    document.getElementById("formprice_strip").value = price;
  }
  <% end %>
}

function getNumberOfDaysBetweenDates(date1, date2) {
  const timeDifference = date2.getTime() - date1.getTime();
  const millisecondsInADay = 1000 * 60 * 60 * 24;

  return Math.round(timeDifference / millisecondsInADay);
}

function getMonthlyDiscount(nights, price) {
  if (nights < 29) {
    document.getElementById("modalmonthlydiscount").innerHTML = 0;
    document.getElementById("formmonthlydiscount").value = 0;
    return 0;
  }
  const monthlyDiscount = <%= (@property.monthly_discount / 100) %> * (nights * <%= (@property.price_cents / 100) %>);
  document.getElementById("modalmonthlydiscount").innerHTML = monthlyDiscount.toLocaleString();
  document.getElementById("formmonthlydiscount").value = monthlyDiscount.toLocaleString();
  return monthlyDiscount;
}

</script>